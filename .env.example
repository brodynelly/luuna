# Copy to .env only for your own launcher; the Rust runtime reads the process
# environment, not this file automatically. Never commit real credentials.
LUUNA_DATA_DIR=.luuna
LUUNA_PORT=4242
# Generate a random token >=32 bytes in your shell; do not use an example token.
# LUUNA_API_TOKEN=
# Cloud setup installs Pi here. Other hosts can use their installed pi executable.
LUUNA_PI_COMMAND=/workspace/.tools/luuna-pi/node_modules/.bin/pi
# Explicit provider/model are required when starting a demo run (UI or API).
# LUUNA_PI_PROVIDER=
# LUUNA_PI_MODEL=
LUUNA_RUN_TIMEOUT_SECONDS=600

# Provider secrets belong in secure environment settings. For OpenAI on this
# cloud platform use the supported non-reserved alias (mapped only in Pi child):
# LUUNA_PI_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
