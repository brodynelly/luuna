          "description": "the single task's role: implementer (default), repository_lead or project_orchestrator (an advisory role reads only)"
        },
        "derived-from": {
          "description": "the advisory task of an earlier revision whose proposal the single task copies"
        },
        "criterion": {
          "repeat": true,
          "description": "a task acceptance criterion (repeatable)"
        },
        "task": {
          "repeat": true,
          "description": "a task for a multi-repository plan as <repository>=<path,...>[>dependency-task,...][;role=<role>][;derived_from=<task>] (repeatable; task ids are the repository ids)"
        },
        "override": {
          "repeat": true,
          "description": "a dependency override as <consumer>:<producer>:<waive|add>:<justification> (repeatable; the refusal that needs one quotes it)"
        },
        "workers": {
          "description": "concurrent writers for a multi-task plan (1 to the number of tasks, at most 4)"
        },
        "attempts": {
          "description": "writer attempts (1 to 10)"
        },
        "timeout": {
          "description": "time budget in seconds (1 to 86400)"
        },
        "cost-usd": {
          "description": "cost budget in dollars (at most 1000)"
        },
        "check": {
          "repeat": true,
          "description": "a testing-setup check recipe as <id>=<executable>[,<arg>,...][@<timeout seconds>] (repeatable; testing_setup tickets only; default timeout 600)"
        },
        "checks": {
          "description": "a JSON file (or - for standard input) listing testing-setup check recipes in the manifest-check shape (id, executable, args, cwd, timeout_seconds, capabilities)"
        },
        "memory": {
          "repeat": true,
          "description": "a selected memory id (repeatable; components only)"
        },
        "prompt": {
          "description": "a selected prompt as name@version#hash (components only)"
        },
        "key": {
          "description": "idempotency key (generated when omitted)"
        }
      },
      "example": {
        "args": [
          "ticket-1"
        ],
        "flags": {
          "repository": "app",
          "path": [
            "src"
          ],
          "attempts": "2",
          "key": "k4"
        }
