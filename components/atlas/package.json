{
  "name": "@luuna/atlas-cli",
  "version": "0.11.0",
  "description": "Luuna Atlas \u2014 structured expertise and project memory",
  "type": "module",
  "bin": {
    "luuna-atlas": "src/cli.ts",
    "la": "src/cli.ts",
    "ml": "src/cli.ts",
    "mulch": "src/cli.ts"
  },
  "main": "src/index.ts",
  "files": [
    "src",
    "UPSTREAM.md"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "biome check --error-on-warnings src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "typecheck": "tsc --noEmit",
    "check:size": "bun run scripts/check-file-sizes.ts",
    "check:debt": "bun run scripts/check-debt-markers.ts",
    "check:dups": "bunx jscpd",
    "check:deps": "bunx knip --dependencies --include-entry-exports",
    "check:coverage": "bun run scripts/check-coverage.ts",
    "check:agents": "bun run scripts/validate-agents-md.ts",
    "check:ci-parity": "bun scripts/check-ci-parity.ts",
    "check:all": "bun scripts/check-all.ts",
    "verify": "bun run typecheck && bun run check:agents && bun test --timeout 30000",
    "report:timing": "bun run scripts/report-test-timing.ts",
    "report:quality": "bun run scripts/report-quality-metrics.ts",
    "test:ci": "bun test --coverage --coverage-reporter=lcov --reporter=junit --reporter-outfile=junit.xml",
    "version:bump": "bun run scripts/version-bump.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "ai",
    "agents",
    "expertise",
    "knowledge-management",
    "cli",
    "developer-tools"
  ],
  "author": "Jaymin West",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brodynelly/luuna.git",
    "directory": "components/atlas"
  },
  "homepage": "https://github.com/brodynelly/luuna/tree/main/components/atlas",
  "bugs": {
    "url": "https://github.com/brodynelly/luuna/issues"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "jscpd": "^4.0.5",
    "knip": "^6.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "private": true,
  "contributors": [
    "Luuna contributors"
  ],
  "packageManager": "bun@1.4.3"
}
