{
  "name": "luuna",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "npm@11.9.0",
  "workspaces": ["apps/desktop", "packages/api-client"],
  "scripts": {
    "dev": "npm run dev --workspace @luuna/desktop",
    "desktop": "npm run tauri --workspace @luuna/desktop -- dev",
    "build": "npm run build --workspace @luuna/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:contracts && npm run test:guard && npm run test --workspaces --if-present",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:guard": "node --test \"tools/pi/test/**/*.test.mjs\""
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright-core": "1.56.1"
  }
}
