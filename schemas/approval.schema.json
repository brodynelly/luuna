{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "plan_id",
    "plan_revision",
    "plan_hash",
    "approved_by",
    "approved_at",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "operations"
      ],
      "properties": {
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "write",
              "shell",
              "network",
              "publish"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luuna:approval:0.1",
  "title": "Luuna approval contract"
}
