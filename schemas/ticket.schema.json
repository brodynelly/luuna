{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luuna ticket (temporary local source)",
  "description": "A ticket is the unit of intent a plan revision binds to. Until the Missions adapter exists (ADR 0003, M6) the only source is the temporary local SQLite record, which never claims external synchronisation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "revision", "source", "title", "intent", "acceptance_criteria", "repository_ids", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "source": { "enum": ["luuna_sqlite_temporary"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "intent": { "type": "string", "minLength": 1, "maxLength": 16000 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
    "repository_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
