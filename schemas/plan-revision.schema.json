{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "id",
    "revision",
    "ticket_id",
    "ticket_revision",
    "manifest_hash",
    "base_commits",
    "candidate_hash",
    "permissions",
    "tasks",
    "required_checks",
    "budgets",
    "hash",
    "project_id"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "canonicalization": {
      "const": "luuna-json-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket_revision": {
      "type": "integer",
      "minimum": 1
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "base_commits": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
      }
    },
    "candidate_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "operations"
      ],
      "properties": {
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:\\.|(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)(?!.*(?:^|/)(?:\\.[Gg][Ii][Tt]|[Gg][Ii][Tt]~1)[. ]*(?:/|$))[^\\u0000-\\u001f\\u007f]+)$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "write",
              "shell",
              "network",
              "publish"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_id",
          "role",
          "depends_on",
          "paths",
          "operations",
          "acceptance_criteria",
          "execution_profile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "implementer",
              "repository_lead",
              "project_orchestrator"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:\\.|(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)(?!.*(?:^|/)(?:\\.[Gg][Ii][Tt]|[Gg][Ii][Tt]~1)[. ]*(?:/|$))[^\\u0000-\\u001f\\u007f]+)$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "operations": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write",
                "shell",
                "network",
                "publish"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "execution_profile": {
            "type": "string",
            "minLength": 1
          },
          "derived_from_task": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_id",
          "executable",
          "args",
          "cwd",
          "timeout_seconds",
          "required",
          "capabilities",
          "execution_profile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "required": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "execution_profile": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "const": true
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_workers",
        "max_attempts",
        "timeout_seconds",
        "cost_usd_micros"
      ],
      "properties": {
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "cost_usd_micros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": ["feature", "testing_setup"],
      "description": "Copied from the ticket and part of the hash; absent means feature. A testing_setup plan carries the testing-setup role and the recipes that will become the repository's baseline, and is the only plan admitted to implementation without a passing baseline (ADR 0022)."
    },
    "component_context": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory",
            "prompt"
          ],
          "properties": {
            "memory": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "scope",
                  "hash",
                  "content",
                  "provenance"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "enum": [
                      "project",
                      "process",
                      "user"
                    ]
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                  },
                  "provenance": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              }
            },
            "prompt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "version",
                    "hash",
                    "body"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "dependency_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumer",
          "producer",
          "action",
          "justification"
        ],
        "properties": {
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "waive",
              "add"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luuna:plan-revision:0.1",
  "title": "Luuna plan-revision contract"
}
