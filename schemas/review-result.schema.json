{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "candidate_hash",
    "reviewer_session",
    "findings",
    "verdict",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reviewer_session": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "path",
          "line",
          "explanation",
          "evidence"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "warning",
              "blocking"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$)[^\\u0000-\\u001f\\u007f]+$",
            "maxLength": 4096
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0
    },
    "verdict": {
      "enum": [
        "passed",
        "changes_required",
        "blocked"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384,
        "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
      },
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "severity"
                ],
                "properties": {
                  "severity": {
                    "const": "blocking"
                  }
                }
              }
            },
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "changes_required",
              "blocked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luuna:review-result:0.1",
  "title": "Luuna review-result contract"
}
